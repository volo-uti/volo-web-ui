{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // ES2022 (not the template's ES2023): consumers of the published package may run older runtimes
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    // tsc only type-checks; tsup writes dist
    "noEmit": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",

    // The stories and Storybook config import the library through its name, from the source
    "paths": {
      "@volo-uti/volo-web-ui": ["./src/index.ts"]
    }
  },
  "include": ["src", "stories", ".storybook"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx", "src/test-utils"]
}
