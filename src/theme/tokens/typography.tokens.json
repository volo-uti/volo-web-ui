{
  "typography": {
    "$type": "typography",
    "display-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "57px",
        "fontWeight": 700,
        "lineHeight": 1.12,
        "letterSpacing": "-0.25px"
      },
      "$description": "Largest display text, hero sections"
    },
    "display-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "45px",
        "fontWeight": 700,
        "lineHeight": 1.16,
        "letterSpacing": "0px"
      },
      "$description": "Secondary display text"
    },
    "display-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "36px",
        "fontWeight": 700,
        "lineHeight": 1.22,
        "letterSpacing": "0px"
      },
      "$description": "Smallest display text"
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "32px",
        "fontWeight": 700,
        "lineHeight": 1.25,
        "letterSpacing": "0px"
      },
      "$description": "Page-level headings"
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "28px",
        "fontWeight": 700,
        "lineHeight": 1.29,
        "letterSpacing": "0px"
      },
      "$description": "Section headings"
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "24px",
        "fontWeight": 600,
        "lineHeight": 1.33,
        "letterSpacing": "0px"
      },
      "$description": "Subsection headings"
    },
    "h4": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "22px",
        "fontWeight": 600,
        "lineHeight": 1.27,
        "letterSpacing": "0px"
      },
      "$description": "Card titles, dialog titles"
    },
    "h5": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 600,
        "lineHeight": 1.5,
        "letterSpacing": "0.15px"
      },
      "$description": "List item titles, tab labels"
    },
    "h6": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 600,
        "lineHeight": 1.43,
        "letterSpacing": "0.1px"
      },
      "$description": "Compact section titles"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0.5px"
      },
      "$description": "Primary body text"
    },
    "body-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.43,
        "letterSpacing": "0.25px"
      },
      "$description": "Default body text"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.33,
        "letterSpacing": "0.4px"
      },
      "$description": "Secondary body text, descriptions"
    },
    "overline": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": 1.43,
        "letterSpacing": "0.1px"
      },
      "$description": "Button labels, form labels"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.33,
        "letterSpacing": "0.5px"
      },
      "$description": "Image captions, helper text"
    },
    "small": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 500,
        "lineHeight": 1.45,
        "letterSpacing": "0.5px"
      },
      "$description": "Smallest text, footnotes"
    }
  }
}
